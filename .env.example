# Neon DB Connection Strings
# 1. Pooled Connection (Used by Next.js Route Handlers at runtime for serverless scale)
DATABASE_URL="postgresql://<user>:<password>@<neon-host>-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# 2. Direct Connection (Used by Prisma CLI for migrations to bypass PgBouncer DDL lock limitations)
DIRECT_URL="postgresql://<user>:<password>@<neon-host>.region.aws.neon.tech/neondb?sslmode=require"

PORT=3000
AUTH_SECRET="your-32-byte-secret-for-jwt-signing"
