{
  "name": "pathpilot-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "cpp:build": "g++ -std=c++17 -O2 -I cpp/include cpp/src/GraphEngine.cpp cpp/src/main.cpp -o cpp/bin/graph_engine.exe && g++ -std=c++17 -O2 -I cpp/include cpp/src/GraphEngine.cpp cpp/tests/graph_engine_tests.cpp -o cpp/bin/graph_engine_tests.exe",
    "cpp:test": "cpp\\bin\\graph_engine_tests.exe",
    "test:integration": "tsx tests/integration.test.ts",
    "test:all": "npm run cpp:test && npm run test:integration"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@prisma/client": "^5.22.0",
    "@xyflow/react": "^12.12.0",
    "bcryptjs": "^3.0.3",
    "html-to-image": "^1.11.13",
    "jose": "^6.2.13",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.61.0",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/dagre": "^0.7.54",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
