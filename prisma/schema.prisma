// PathPilot - Personalized Learning Path Planner
// Senior Backend & Database Architecture Schema for Neon DB (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =========================================================================
// ENUMS (P1-2)
// =========================================================================

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum Level {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ResourceType {
  VIDEO
  COURSE
  DOCS
  PRACTICE
  BOOK
}

// =========================================================================
// USER MODEL
// =========================================================================

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  name             String?
  passwordHash     String?
  image            String?
  yearOfStudy      Int?
  branch           String?
  onboarded        Boolean           @default(false)
  weeklyStudyHours Int               @default(10) // Supports time-constrained planning
  targetGoalId     String?
  createdAt        DateTime          @default(now())

  targetGoal       Goal?             @relation(fields: [targetGoalId], references: [id], onDelete: SetNull)
  progress         StudentProgress[]
  studyLogs        StudyLog[]
  savedRoadmaps    SavedRoadmap[]

  @@map("users")
}

// =========================================================================
// GRAPH NODE MODEL: COURSE
// =========================================================================

model Course {
  id             String            @id @default(uuid())
  code           String            @unique // e.g. "CS101", "MATH201" for graph node labeling
  title          String
  description    String            @db.Text
  estimatedHours Int               // Effort required for time-constrained roadmap calculation
  category       String            @default("General") // "Mathematics", "Core CS", "AI/ML", etc.
  level          Level             @default(BEGINNER)
  difficulty     Int               @default(1) // 1-5
  createdAt      DateTime          @default(now())

  // Self-referencing many-to-many relationship for DAG edges:
  prerequisites  Prerequisite[]    @relation("CourseAsCourse")
  requiredFor    Prerequisite[]    @relation("CourseAsPrerequisite")

  students       StudentProgress[]
  goals          GoalCourse[]
  resources      CourseResource[]

  @@index([code])
  @@map("courses")
}

// =========================================================================
// GRAPH EDGE TABLE: PREREQUISITE (Directed Edge in DAG)
// =========================================================================

model Prerequisite {
  courseId             String
  prerequisiteCourseId String

  course               Course   @relation("CourseAsCourse", fields: [courseId], references: [id], onDelete: Cascade)
  prerequisiteCourse   Course   @relation("CourseAsPrerequisite", fields: [prerequisiteCourseId], references: [id], onDelete: Cascade)

  @@id([courseId, prerequisiteCourseId])
  @@index([courseId])
  @@index([prerequisiteCourseId])
  @@map("prerequisites")
}

// =========================================================================
// STUDENT PROGRESS (Knowledge-Aware Roadmaps)
// =========================================================================

model StudentProgress {
  id          String         @id @default(uuid())
  userId      String
  courseId    String
  status      ProgressStatus @default(NOT_STARTED)
  isCompleted Boolean        @default(false) // Kept for backwards compatibility with tests and C++ bridge
  startedAt   DateTime?
  completedAt DateTime?
  hoursSpent  Int            @default(0)
  updatedAt   DateTime       @updatedAt

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("student_progress")
}

// =========================================================================
// COURSE RESOURCES (P1-3)
// =========================================================================

model CourseResource {
  id        String       @id @default(uuid())
  courseId  String
  title     String
  provider  String       // e.g. "freeCodeCamp", "MIT OCW", "YouTube"
  url       String
  type      ResourceType
  isFree    Boolean      @default(true)
  hours     Int?
  isPrimary Boolean      @default(false)

  course    Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@map("course_resources")
}

// =========================================================================
// REAL HOURS + STREAK ACTIVITY LOGS (P1-2)
// =========================================================================

model StudyLog {
  id       String   @id @default(uuid())
  userId   String
  courseId String?
  hours    Float
  date     DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("study_logs")
}

// =========================================================================
// SAVED / EXPORTED ROADMAPS (P0-4)
// =========================================================================

model SavedRoadmap {
  id        String   @id @default(uuid())
  userId    String
  goalId    String
  name      String
  snapshot  Json     // order, nodes, edges, progress at save time
  shareSlug String   @unique
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_roadmaps")
}

// =========================================================================
// GOAL-BASED SUBGRAPH EXTRACTION
// =========================================================================

model Goal {
  id          String         @id @default(uuid())
  name        String         @unique // e.g. "Machine Learning Engineer", "DSA Interview Preparation"
  slug        String         @unique
  description String?        @db.Text
  icon        String?
  color       String?
  createdAt   DateTime       @default(now())

  users       User[]
  courses     GoalCourse[]
  saved       SavedRoadmap[]

  @@map("goals")
}

model GoalCourse {
  goalId     String
  courseId   String
  isTerminal Boolean  @default(false) // Target capstone node for reverse BFS/DFS subgraph isolation

  goal       Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([goalId, courseId])
  @@index([goalId])
  @@index([courseId])
  @@map("goal_courses")
}
